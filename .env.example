# LLM Provider - NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_nim_key_here

# TradingAgents Config
TRADINGAGENTS_LLM_PROVIDER=nvidia
TRADINGAGENTS_DEEP_THINK_LLM=meta/llama-3.1-70b-instruct
TRADINGAGENTS_QUICK_THINK_LLM=meta/llama-3.1-8b-instruct
TRADINGAGENTS_TEMPERATURE=0.1
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Alpaca Paper Trading
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Twelve Data API Keys (comma-separated for rotation)
TWELVE_DATA_KEYS=your_first_key,your_second_key,your_third_key

# FRED API Key (optional, for macro data)
FRED_API_KEY=your_fred_api_key_here

# Email Notifications (Gmail)
SENDER_EMAIL=your_email@gmail.com
RECEIVER_EMAIL=recipient_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
